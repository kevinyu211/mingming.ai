  "cards": [
    {
      "dot": "amber",
      "title": "Model reads and phrases; code decides",
      "items": [
        "Model: read the page into fields verbatim, and write the sentence a daughter would say (Claude Sonnet 5 via the Vercel AI Gateway)",
        "Code: warning signs first, refusals and crisis referral before any model call, citations checked against server-built cards, dose counters that never turn a frequency into a clock time",
        "ESLint forbids lib/rules from importing the model"
      ]
    },
    {
      "dot": "cyan",
      "title": "What leaves the phone, and what does not",
      "items": [
        "Leaves: the page as a 2400 px JPEG, the cards, the question and the last turns; card text to MiniMax; the recorded question to OpenAI",
        "Never: a name, a relationship word, a date or an identifier; the server stores and logs nothing",
        "Stays: one browser-storage key with the reading, thread, counters and memory; one button deletes it all"
      ]
    }
  ]
