# Model calls go through the Vercel AI Gateway (lib/model/client.ts). A model is a Gateway slug,
# "provider/model"; any of the 300+ models the Gateway lists works here without a code change:
#   google/gemini-3.8-flash   anthropic/claude-sonnet-5   openai/gpt-5.6-terra   alibaba/qwen3.8-flash
# MODEL_READ reads the photographed sheet; MODEL_ASK answers questions and re-phrases cards.
# Production runs Sonnet 5 for both (set 2026-09-04): reads 23–26 s, answers ~5 s warm, and every
# accuracy number in docs/submission was measured on Claude. Gemini 3.8 answered asks well too
# but one read in four came back invalid at 178 s.
MODEL_READ=anthropic/claude-sonnet-5
MODEL_ASK=anthropic/claude-sonnet-5
# Gateway auth: on Vercel the deployment's OIDC token is used automatically. Locally, run
# `vercel env pull .env.local` to get a VERCEL_OIDC_TOKEN (valid ~24 h), or set a Gateway API key.
# Not every slug is reachable on every plan: measured 2026-09-04 on the free tier,
# google/gemini-3.8-flash answers 403 "upgrade to paid credits", anthropic/claude-sonnet-5 and
# openai/gpt-5-mini are rate-limited, and google/gemini-2.5-flash and openai/gpt-4o-mini work.
AI_GATEWAY_API_KEY=

# Speech providers (server-side only). Chosen by the listening test, see tests/eval/voices.md
TTS_PROVIDER=browser          # minimax | elevenlabs | azure | browser
STT_PROVIDER=openai           # openai | elevenlabs | azure | browser
# "cloud" records with MediaRecorder and uploads the clip; the transcript comes back whole, about
# a second after the hold ends. Anything else uses the browser's own recogniser, which types the
# words out live but mishears more and is the phone's dictation rather than ours. The two used to
# run together and that was the bug: two engines on one microphone lost roughly one hold in three
# (lib/speech/stt.ts). This one IS exposed to the browser.
NEXT_PUBLIC_STT_MODE=cloud    # cloud | browser
OPENAI_API_KEY=
# gpt-4o-mini-transcribe (default) | gpt-4o-transcribe | whisper-1
OPENAI_STT_MODEL=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
