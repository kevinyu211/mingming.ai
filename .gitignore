# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values and is the only list of what this app needs.
# README's first step is `cp .env.example .env.local`, and that step cannot work from a clone
# unless the file is actually in the clone.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent folders may hold local credentials
.claude/settings.local.json

# generated eval audio and voice recordings
tests/eval/out/
tests/eval/clips/*.m4a
tests/eval/clips/*.wav
tests/eval/clips/*.mp3
fixtures/sheets/out/

# playwright output
test-results/
playwright-report/

# mascot source art — 20 MB of 1536×1024 PNGs on white. What ships is public/mascot/*.webp,
# rebuilt from this by scripts/build-mascots.mjs.
/mascots-v5-natural.zip

# agent tool folder (spec-driven-development scaffolding), local only
.superpowers/

# backup video and its run log: a deliverable for the organisers, not for the repo
docs/backup-video/

# Venue-only copies and live-review evidence: kept beside the repo, never in it
docs/mingming-pitch-deck.html
docs/review-2026-09-05/

# graphify knowledge graph (10 MB, rebuildable with /graphify)
graphify-out/
